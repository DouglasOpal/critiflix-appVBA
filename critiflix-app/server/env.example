# ---- Core ----
NODE_ENV=production
PORT=4000

# ---- Database (MongoDB Atlas free tier M0) ----
# Atlas → Connect → Drivers → copy the SRV string; add the DB name (…/critiflix).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/critiflix?retryWrites=true&w=majority

# ---- Auth secrets (use long random strings; Render can generate these) ----
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ---- First admin (created on first boot when the DB is empty) ----
ADMIN_EMAIL=admin@critiflix.app
ADMIN_NAME=CritiFlix Admin
ADMIN_PASSWORD=choose-a-strong-admin-password
SEED_ON_START=true

# ---- Admin console self-service account creation (optional) ----
# Set this to a private, hard-to-guess string and share it only with people who
# should be able to create their own admin login. Leave unset to disable the
# "Create account" option on the admin console entirely.
ADMIN_SIGNUP_CODE=

# Twilio Console → Account Info. Phone/WhatsApp OTP send for real only when
# these are set; otherwise the code is logged and returned for testing.
# ---- Twilio: SMS tokens (signup/reset/cashout) + WhatsApp OTP/promotions ----
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM=+12025550123
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ---- Twilio SendGrid: email OTP (signup/reset) + product update alerts ----
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=no-reply@critiflix.net
EMAIL_FROM_NAME=CritiFlix

# ---- Paystack (payments) ----
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# Set to your deployed URL once live:
PAYSTACK_CALLBACK_URL=https://api.critiflix.net/api/me/subscribe/callback

# ---- critiflix.net domain ----
PUBLIC_SITE_URL=https://critiflix.net
PUBLIC_API_URL=https://api.critiflix.net
# Website contact form messages are delivered here (via SendGrid)
CONTACT_TO=hello@critiflix.net

# ---- Cloudflare R2 media storage (trailers, posters, avatars, logos) ----
# Cloudflare dashboard → R2 → create bucket "critiflix-media" → Settings →
# Custom Domains → media.critiflix.net. Then R2 → Manage API tokens →
# "Object Read & Write" for that bucket. Leave blank to keep files on local disk (dev only).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=critiflix-media
R2_PUBLIC_URL=https://media.critiflix.net
